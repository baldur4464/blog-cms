# Datenbank
DB_NAME=blogcms
DB_USERNAME=blogcms
DB_PASSWORD=CHANGE_ME

# JWT (mind. 32 zufällige Zeichen)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# Bootstrap Admin (nur beim ersten Start relevant)
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Port der Anwendung (Standard: 80)
PORT=80
